# Multi-Platform Auto-Apply Bot Configuration
# Copy this file to .env and fill in your details
# NEVER commit .env to git (it is included in .gitignore)

# Portal Credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password
GEMINI_API_KEY=your_gemini_api_key_here
RESUME_PATH=resume.pdf

# Candidate Personal Details
FIRSTNAME=YourFirstName
LASTNAME=YourLastName
CANDIDATE_NAME=Your Full Name
CANDIDATE_EMAIL=your_email@example.com
CANDIDATE_PHONE=9999999999
CANDIDATE_GITHUB=https://github.com/your-username
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-username
CANDIDATE_CGPA=8.5
CANDIDATE_DEGREE=B.E. in Computer Science and Engineering
CANDIDATE_GRAD_YEAR=2026
CANDIDATE_BIO=Passionate software engineer graduate with hands-on full-stack development experience across Python, JavaScript, React, Node.js, and SQL.
CANDIDATE_WHY_HIRE=Demonstrated practical experience building deployed projects end to end with modern Git workflows, responsive design, and robust testing.
CANDIDATE_WHY_ROLE=Strongly aligned with my technical foundation in full-stack development and eager to contribute to impactful engineering teams.
CANDIDATE_PROJECT_SUMMARY=Built full-stack platforms featuring RESTful APIs, responsive interfaces, authentication, and database integration.
CANDIDATE_EXPERIENCE_SUMMARY=Completed software engineering internships and deployed production-grade personal projects.

# Job Search Settings
KEYWORDS=Python Developer, Full Stack Developer, Django, React.js
LOCATION=Bangalore
PAGES_PER_KEYWORD=2
MAX_APPLICATIONS=50
